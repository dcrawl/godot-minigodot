#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_miniscript = env_modules.Clone()

# Thirdparty MiniScript interpreter sources

thirdparty_dir = "#thirdparty/miniscript/"

thirdparty_sources = [
    "SimpleString.cpp",
    "SimpleVector.cpp",
    "List.cpp",
    "Dictionary.cpp",
    "MiniscriptKeywords.cpp",
    "MiniscriptTypes.cpp",
    "MiniscriptLexer.cpp",
    "MiniscriptParser.cpp",
    "MiniscriptTAC.cpp",
    "MiniscriptInterpreter.cpp",
    "MiniscriptIntrinsics.cpp",
    "UnicodeUtil.cpp",
    "SplitJoin.cpp",
    "QA.cpp",
    "UnitTest.cpp",
]

thirdparty_sources = [thirdparty_dir + f for f in thirdparty_sources]

env_miniscript.Prepend(CPPPATH=[thirdparty_dir])

env_thirdparty = env_miniscript.Clone()
env_thirdparty.disable_warnings()
# MiniScript uses C++ exceptions for error handling; re-enable them for these sources.
if not env_thirdparty.msvc:
    env_thirdparty["CXXFLAGS"] = [f for f in env_thirdparty.get("CXXFLAGS", []) if f != "-fno-exceptions"]
else:
    env_thirdparty["CPPDEFINES"] = [d for d in env_thirdparty.get("CPPDEFINES", []) if d != ("_HAS_EXCEPTIONS", 0)]
    env_thirdparty.Append(CXXFLAGS=["/EHsc"])

thirdparty_obj = []
env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)
env.modules_sources += thirdparty_obj

# Module source files
# Files that include MiniScript thirdparty headers must be compiled with exceptions enabled,
# since MiniscriptErrors.h declares inline throw() helpers used by the MiniScript type system.

bridge_sources = [
    "miniscript_instance.cpp",
    "miniscript_godot_intrinsics.cpp",
    "register_types.cpp",
]

module_obj = []

# Compile bridge files with exceptions enabled (same env as thirdparty).
for src in bridge_sources:
    env_thirdparty.add_source_files(module_obj, src)

# Compile remaining module files with the standard module env.
import os
all_sources = [f for f in Glob("*.cpp") if os.path.basename(str(f)) not in bridge_sources]
env_miniscript.add_source_files(module_obj, all_sources)

env.modules_sources += module_obj

env.Depends(module_obj, thirdparty_obj)
